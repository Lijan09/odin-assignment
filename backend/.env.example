# Copy this file to .env and fill in your own values. .env is gitignored.
# AI_PROVIDER=mock runs the app with no API key and no network access.
AI_PROVIDER=mock

# Set AI_PROVIDER=gemini to use the real LLM. Free key: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=10

# SQLite file, created on first run, relative to the backend/ directory.
DATABASE_PATH=odin_tasks.db
