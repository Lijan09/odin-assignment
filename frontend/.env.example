# Copy this file to .env to point the dev server at a backend somewhere other than
# the default. Without a .env the default below is used, so no setup is required.
#
# Deliberately NOT prefixed with VITE_. Vite compiles every VITE_* variable into
# the browser bundle; this one is read by vite.config.ts in Node and only
# configures the dev-server proxy, so it never reaches the client.

API_PROXY_TARGET=http://127.0.0.1:8000
